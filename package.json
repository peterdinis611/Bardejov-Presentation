{
  "name": "bardejov",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/opt-images.mjs && vite build",
    "images": "node scripts/opt-images.mjs",
    "build:pages": "node scripts/opt-images.mjs && VITE_BASE=/Bardejov-Presentation/ VITE_SITE_URL=https://peterdinis611.github.io/Bardejov-Presentation vite build",
    "preview": "vite preview",
    "i18n": "node scripts/i18n.mjs",
    "tts": "node scripts/tts.mjs",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check . && node scripts/i18n.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vite": "^6.3.5"
  }
}
